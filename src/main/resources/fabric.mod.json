{
  "schemaVersion": 1,
  "id": "vanillaclient",
  "version": "${version}",
  "name": "Vanilla Client",
  "description": "A clean helper for Hardcore/UHC: HUD, map, waypoints, tasks, guide, crosshair, cosmetics and ranks. Client-side; on servers/LAN worlds with the mod, players see each other's cosmetics.",
  "authors": [
    "Dawid"
  ],
  "license": "MIT",
  "icon": "assets/vanillaclient/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.vanillaclient.net.CommonInit"
    ],
    "client": [
      "dev.vanillaclient.VanillaClient"
    ]
  },
  "mixins": [
    {
      "config": "vanillaclient.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": ">=26.3- <26.4",
    "java": ">=25"
  }
}