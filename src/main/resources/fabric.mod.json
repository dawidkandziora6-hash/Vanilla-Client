{
  "schemaVersion": 1,
  "id": "vanillaclient",
  "version": "${version}",
  "name": "Vanilla Client",
  "description": "A clean, client-side helper for Hardcore/UHC: days, tasks, armor status, zoom, custom crosshair, images and cosmetics – without changing the game.",
  "authors": ["Dawid"],
  "license": "MIT",
  "icon": "assets/vanillaclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.vanillaclient.VanillaClient"]
  },
  "mixins": [
    { "config": "vanillaclient.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": ">=26.3- <26.4",
    "java": ">=25"
  }
}
